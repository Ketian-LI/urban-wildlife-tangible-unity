{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "city_state_v0.1.schema.json",
  "title": "Urban Wildlife Multispecies City State V0.1",
  "type": "object",
  "required": [
    "schema_version",
    "city_id",
    "revision",
    "source_contract",
    "bounds",
    "buildings",
    "green_patches",
    "vehicle_roads",
    "pedestrian_links",
    "amenities",
    "waste"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "city_id": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "source_contract": { "type": "string", "minLength": 1 },
    "bounds": { "$ref": "#/$defs/bounds" },
    "planning_grid": { "$ref": "#/$defs/planningGrid" },
    "buildings": {
      "type": "array",
      "items": { "$ref": "#/$defs/building" }
    },
    "green_patches": {
      "type": "array",
      "items": { "$ref": "#/$defs/greenPatch" }
    },
    "vehicle_roads": {
      "type": "array",
      "items": { "$ref": "#/$defs/vehicleRoad" }
    },
    "pedestrian_links": {
      "type": "array",
      "items": { "$ref": "#/$defs/pedestrianLink" }
    },
    "amenities": {
      "type": "array",
      "items": { "$ref": "#/$defs/amenity" }
    },
    "waste": { "$ref": "#/$defs/wasteSystem" }
  },
  "$defs": {
    "point": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "number", "minimum": 0, "maximum": 1 }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "polyline": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/point" }
    },
    "nonNegative": { "type": "number", "minimum": 0 },
    "unitValue": { "type": "number", "minimum": 0, "maximum": 1 },
    "gridSize": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "constructionState": {
      "enum": ["Existing", "Proposed", "UnderConstruction", "DemolitionProposed", "Demolishing"]
    },
    "networkSource": {
      "enum": ["ExistingMap", "AutoGenerated", "ScreenEdited", "LegacyAdapter"]
    },
    "bounds": {
      "type": "object",
      "required": ["origin", "width_units", "height_units"],
      "properties": {
        "origin": { "const": "top_left" },
        "width_units": { "type": "number", "exclusiveMinimum": 0 },
        "height_units": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "planningGrid": {
      "type": "object",
      "required": ["cols", "rows", "max_active_player_buildings", "cells"],
      "properties": {
        "cols": { "const": 6 },
        "rows": { "const": 4 },
        "max_active_player_buildings": { "const": 9 },
        "cells": {
          "type": "array",
          "minItems": 24,
          "maxItems": 24,
          "items": { "$ref": "#/$defs/gridCell" }
        }
      }
    },
    "gridCell": {
      "type": "object",
      "required": [
        "id",
        "row",
        "col",
        "center_norm",
        "size_norm",
        "baseline_cover",
        "current_cover",
        "buildable",
        "fixed_feature",
        "occupant_id",
        "habitat_patch_id",
        "was_woodland",
        "last_changed_revision"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-D][1-6]$" },
        "row": { "type": "integer", "minimum": 0, "maximum": 3 },
        "col": { "type": "integer", "minimum": 0, "maximum": 5 },
        "center_norm": { "$ref": "#/$defs/point" },
        "size_norm": { "$ref": "#/$defs/gridSize" },
        "baseline_cover": { "$ref": "#/$defs/landCover" },
        "current_cover": { "$ref": "#/$defs/landCover" },
        "buildable": { "type": "boolean" },
        "fixed_feature": { "type": "boolean" },
        "occupant_id": { "type": ["string", "null"] },
        "habitat_patch_id": { "type": ["string", "null"] },
        "was_woodland": { "type": "boolean" },
        "last_changed_revision": { "type": "integer", "minimum": 0 }
      }
    },
    "landCover": {
      "enum": [
        "OpenLand",
        "Woodland",
        "PublicGreen",
        "Water",
        "CivicPlaza",
        "Building",
        "ShrubGarden",
        "Disturbed",
        "Recovering"
      ]
    },
    "building": {
      "type": "object",
      "required": [
        "id",
        "source_token_id",
        "type",
        "construction_state",
        "position_norm",
        "rotation_deg",
        "footprint_units",
        "housing_capacity",
        "human_origin_rate",
        "human_destination_weight",
        "comfortable_capacity",
        "vehicle_demand",
        "waste_output",
        "anthropogenic_food_output",
        "disturbance_output",
        "requires_vehicle_access",
        "requires_pedestrian_access",
        "vehicle_road_ids",
        "pedestrian_link_ids"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source_token_id": { "type": "integer", "minimum": -1 },
        "planning_cell_id": { "type": ["string", "null"] },
        "type": { "enum": ["Apartment", "DetachedHouse", "Commercial", "CommunityFacility"] },
        "construction_state": { "$ref": "#/$defs/constructionState" },
        "position_norm": { "$ref": "#/$defs/point" },
        "rotation_deg": { "type": "number" },
        "footprint_units": {
          "type": "array",
          "prefixItems": [
            { "type": "number", "exclusiveMinimum": 0 },
            { "type": "number", "exclusiveMinimum": 0 }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "housing_capacity": { "type": "integer", "minimum": 0 },
        "human_origin_rate": { "$ref": "#/$defs/nonNegative" },
        "human_destination_weight": { "$ref": "#/$defs/nonNegative" },
        "comfortable_capacity": { "type": "integer", "minimum": 0 },
        "vehicle_demand": { "$ref": "#/$defs/nonNegative" },
        "waste_output": { "$ref": "#/$defs/nonNegative" },
        "anthropogenic_food_output": { "$ref": "#/$defs/nonNegative" },
        "disturbance_output": { "$ref": "#/$defs/nonNegative" },
        "requires_vehicle_access": { "type": "boolean" },
        "requires_pedestrian_access": { "type": "boolean" },
        "vehicle_road_ids": { "type": "array", "items": { "type": "string" } },
        "pedestrian_link_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "greenPatch": {
      "type": "object",
      "required": [
        "id",
        "source_token_id",
        "type",
        "construction_state",
        "public_park",
        "polygon_norm",
        "shelter_value",
        "natural_food_value",
        "human_disturbance",
        "patch_size_units",
        "connected_patch_ids"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source_token_id": { "type": "integer", "minimum": -1 },
        "planning_cell_id": { "type": ["string", "null"] },
        "type": { "enum": ["Woodland", "ShrubGarden", "OpenGrass"] },
        "construction_state": { "$ref": "#/$defs/constructionState" },
        "public_park": { "type": "boolean" },
        "polygon_norm": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/point" }
        },
        "shelter_value": { "$ref": "#/$defs/unitValue" },
        "natural_food_value": { "$ref": "#/$defs/unitValue" },
        "human_disturbance": { "$ref": "#/$defs/unitValue" },
        "patch_size_units": { "type": "number", "exclusiveMinimum": 0 },
        "connected_patch_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "vehicleRoad": {
      "type": "object",
      "required": [
        "id",
        "role",
        "route_option",
        "construction_state",
        "source",
        "points_norm",
        "width_units",
        "speed_units_per_second",
        "traffic_load",
        "connected_building_ids",
        "connected_road_ids"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "enum": ["Main", "Local", "BuildingAccess"] },
        "route_option": { "enum": ["Existing", "Direct", "ExistingNetwork", "LowImpact"] },
        "construction_state": { "$ref": "#/$defs/constructionState" },
        "source": { "$ref": "#/$defs/networkSource" },
        "points_norm": { "$ref": "#/$defs/polyline" },
        "width_units": { "type": "number", "exclusiveMinimum": 0 },
        "speed_units_per_second": { "type": "number", "exclusiveMinimum": 0 },
        "traffic_load": { "$ref": "#/$defs/unitValue" },
        "connected_building_ids": { "type": "array", "items": { "type": "string" } },
        "connected_road_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "pedestrianLink": {
      "type": "object",
      "required": [
        "id",
        "type",
        "construction_state",
        "source",
        "points_norm",
        "width_units",
        "step_free_accessible",
        "connected_building_ids",
        "connected_link_ids"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["ExistingNetwork", "BasicBuildingAccess", "ExtraFootpath"] },
        "construction_state": { "$ref": "#/$defs/constructionState" },
        "source": { "$ref": "#/$defs/networkSource" },
        "points_norm": { "$ref": "#/$defs/polyline" },
        "width_units": { "type": "number", "exclusiveMinimum": 0 },
        "step_free_accessible": { "type": "boolean" },
        "connected_building_ids": { "type": "array", "items": { "type": "string" } },
        "connected_link_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "amenity": {
      "type": "object",
      "required": [
        "id",
        "type",
        "construction_state",
        "position_norm",
        "service_radius_units",
        "human_activity_weight",
        "waste_capacity",
        "food_exposure_reduction"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["Bench", "Bin"] },
        "construction_state": { "$ref": "#/$defs/constructionState" },
        "position_norm": { "$ref": "#/$defs/point" },
        "service_radius_units": { "type": "number", "exclusiveMinimum": 0 },
        "human_activity_weight": { "$ref": "#/$defs/unitValue" },
        "waste_capacity": { "$ref": "#/$defs/nonNegative" },
        "food_exposure_reduction": { "$ref": "#/$defs/unitValue" }
      }
    },
    "wasteSystem": {
      "type": "object",
      "required": [
        "total_demand",
        "total_capacity",
        "overflow_elapsed_seconds",
        "overflow_active",
        "nodes",
        "litter_hotspots"
      ],
      "properties": {
        "total_demand": { "$ref": "#/$defs/nonNegative" },
        "total_capacity": { "$ref": "#/$defs/nonNegative" },
        "overflow_elapsed_seconds": { "$ref": "#/$defs/nonNegative" },
        "overflow_active": { "type": "boolean" },
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/wasteNode" }
        },
        "litter_hotspots": {
          "type": "array",
          "items": { "$ref": "#/$defs/litterHotspot" }
        }
      }
    },
    "wasteNode": {
      "type": "object",
      "required": [
        "id",
        "type",
        "source_building_id",
        "position_norm",
        "generation_rate",
        "capacity",
        "fill_ratio"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["BuildingOutput", "Bin"] },
        "source_building_id": { "type": ["string", "null"] },
        "position_norm": { "$ref": "#/$defs/point" },
        "generation_rate": { "$ref": "#/$defs/nonNegative" },
        "capacity": { "$ref": "#/$defs/nonNegative" },
        "fill_ratio": { "$ref": "#/$defs/unitValue" }
      }
    },
    "litterHotspot": {
      "type": "object",
      "required": ["id", "source_id", "position_norm", "intensity"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source_id": { "type": "string" },
        "position_norm": { "$ref": "#/$defs/point" },
        "intensity": { "$ref": "#/$defs/unitValue" }
      }
    }
  }
}
