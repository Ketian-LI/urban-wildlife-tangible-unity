{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "city_token_scan_v0.1.schema.json",
  "title": "Urban Wildlife City Token Scan V0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_type",
    "timestamp_ms",
    "timestamp_utc",
    "scan_id",
    "session_id",
    "development_phase",
    "calibration_id",
    "coordinate_system",
    "capture",
    "recognition",
    "token_states"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "packet_type": { "const": "city_token_scan" },
    "timestamp_ms": { "type": "integer", "minimum": 1 },
    "timestamp_utc": { "type": "string", "format": "date-time" },
    "scan_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "development_phase": { "type": "integer", "minimum": 1 },
    "calibration_id": { "type": "string", "minLength": 1 },
    "coordinate_system": {
      "type": "object",
      "required": ["origin", "x_axis", "y_axis", "range", "unity_plane_mapping"],
      "properties": {
        "origin": { "const": "top_left" },
        "x_axis": { "const": "right" },
        "y_axis": { "const": "down" },
        "range": {
          "type": "array",
          "prefixItems": [{ "const": 0 }, { "const": 1 }],
          "minItems": 2,
          "maxItems": 2
        },
        "unity_plane_mapping": { "const": "x_norm -> Unity X; y_norm -> Unity Z" }
      }
    },
    "capture": {
      "type": "object",
      "required": ["mode", "stable"],
      "properties": {
        "mode": { "type": "string", "minLength": 1 },
        "stable": { "const": true }
      }
    },
    "recognition": {
      "type": "object",
      "required": ["marker_backend", "marker_family", "token_config_version"],
      "properties": {
        "marker_backend": { "enum": ["aruco", "apriltag"] },
        "marker_family": { "type": "string", "minLength": 1 },
        "token_config_version": { "type": "string", "minLength": 1 }
      }
    },
    "token_states": {
      "type": "array",
      "maxItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "x_norm", "y_norm", "rotation_deg", "confidence"],
        "properties": {
          "id": { "type": "integer", "minimum": 100, "maximum": 142 },
          "type": {
            "enum": [
              "Apartment",
              "DetachedHouse",
              "Commercial",
              "CommunityFacility",
              "GreenIntervention"
            ]
          },
          "x_norm": { "type": "number", "minimum": 0, "maximum": 1 },
          "y_norm": { "type": "number", "minimum": 0, "maximum": 1 },
          "rotation_deg": { "type": "number", "minimum": -180, "maximum": 180 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
